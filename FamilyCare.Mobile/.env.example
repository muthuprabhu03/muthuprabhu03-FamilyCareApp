# ============================================================================
# FamilyCare Mobile (Expo / React Native) - Environment Configuration Template
# ============================================================================
#
# Copy this file to `.env` for local builds or set in EAS Build Secrets.
#
# Production API URL:
# Set this to your deployed ASP.NET Core HTTPS backend URL:
# EXPO_PUBLIC_API_URL=https://api.yourproductiondomain.com
#
# Android Studio Emulator (local debugging):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5093
#
# Physical Device over local Wi-Fi (LAN debugging):
# EXPO_PUBLIC_API_URL=http://192.168.1.X:5093
# ============================================================================

EXPO_PUBLIC_API_URL=https://api.yourproductiondomain.com
